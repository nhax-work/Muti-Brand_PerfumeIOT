# Sao chép thành .env — KHÔNG commit file .env (NFR-SEC-05)

DB_USER=scent
DB_PASSWORD=scent_dev
DB_NAME=scentstation
DB_PORT=5432
DB_TEST_PORT=5433

# Chuỗi kết nối cho migration và ứng dụng. Phải khớp 5 biến ở trên.
DATABASE_URL=postgresql://scent:scent_dev@localhost:5432/scentstation
DATABASE_URL_TEST=postgresql://scent:scent_test@localhost:5433/scentstation_test

REDIS_PORT=6379
MQTT_PORT=1883
MQTT_WS_PORT=9001
ADMINER_PORT=8080

# Broker cho cửa vào MQTT + vòng điều phối lệnh xịt. Bỏ trống thì API chỉ chạy HTTP (không gửi lệnh
# xuống máy). Phải khớp MQTT_PORT ở trên.
MQTT_URL=mqtt://localhost:1883

# Ứng dụng
APP_ENV=development
JWT_SECRET=doi_gia_tri_nay
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=doi_gia_tri_nay
# Khóa riêng Ed25519 dạng PEM ký lệnh xịt (FR-DSP-04). Giữ giá trị mẫu ở máy dev thì lệnh mang chữ
# ký giả `dev-unsigned` — firmware phải bật DEV_ALLOW_UNSIGNED_COMMANDS.
DISPENSE_SIGNING_KEY=doi_gia_tri_nay

# Swagger UI tại http://localhost:3000/api/docs, phục vụ spec/contracts/openapi.yaml. Bỏ trống thì
# bật ở development, tắt ở production.
SWAGGER_ENABLED=

# Mật khẩu cho các tài khoản do scripts/seed.ts tạo. Chỉ dùng ở máy dev (NFR-SEC-05).
SEED_DEFAULT_PASSWORD=DevPassword123!

REFUND_ACCOUNT_ENC_KEY=doi_gia_tri_nay
REFUND_CLAIM_TOKEN_SECRET=doi_gia_tri_nay

# PayOS (ADR-0016) — xem docs/PAYOS.md
PAYOS_CLIENT_ID=nhap
PAYOS_API_KEY=nhap
PAYOS_CHECKSUM_KEY=nhap
PAYOS_RETURN_URL=nhap
PAYOS_CANCEL_URL=nhap
PAYOS_BASE_URL=
# Kiosk: trang khiếu nại mà QR sự cố dẫn tới (ADR-0012)
VITE_CLAIM_PAGE_URL=http://localhost:5173/claim

# Chạy ngrok: ngrok http --url=cattishly-eardrum-expire.ngrok-free.dev 3000 - Sau khi chạy npm run api:dev

ADMIN_WEB_BASE_URL=http://localhost:5173
DEV_LOG_EMAIL_VERIFICATION_TOKEN=false

# Cấu hình gửi Email SMTP thật (FR-USR-07, FR-ALR-16)
# Ví dụ gửi qua Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your_email@gmail.com, SMTP_PASS=app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Kho ảnh sản phẩm (ADR-0020)
# local: lưu vào MEDIA_DIR, API phục vụ tại /api/v1/media (máy dev chưa có khóa R2, test, CI).
# r2: lưu lên Cloudflare R2 qua S3 API — cần đủ R2_* và MEDIA_PUBLIC_BASE_URL dạng https.
MEDIA_STORAGE_DRIVER=local
MEDIA_DIR=storage/media
# Để trống với local thì mặc định http://localhost:<PORT>/api/v1/media.
# Với r2: URL công khai của bucket, ví dụ https://pub-xxxxxxxx.r2.dev hoặc https://img.ten-mien.vn
MEDIA_PUBLIC_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
