{
  "name": "scentstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ScentStation — nền tảng máy trải nghiệm nước hoa theo mô hình cho thuê slot",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "db:migrate": "node-pg-migrate up -m migrations -t pgmigrations",
    "db:migrate:down": "node-pg-migrate down -m migrations -t pgmigrations",
    "db:migrate:create": "node-pg-migrate create -m migrations -j sql",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 5 && npm run db:migrate && npm run db:seed",
    "db:seed": "tsx scripts/seed.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e --passWithNoTests",
    "test:watch": "vitest",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:traceability": "node scripts/check-traceability.mjs",
    "check:openapi": "redocly lint spec/contracts/openapi.yaml",
    "check": "npm run lint && npm run test && npm run check:traceability",
    "lint": "eslint . && tsc --noEmit && npm run typecheck -w @scentstation/api",
    "fmt": "prettier --write .",
    "sim": "tsx scripts/device-simulator.ts",
    "sim:many": "tsx scripts/device-simulator.ts --machines=50",
    "api:dev": "npm run dev -w @scentstation/api",
    "contracts:generate": "npm run generate -w @scentstation/contracts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@redocly/cli": "^2.53.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "5.0.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.16.0",
    "js-yaml": "^5.4.2",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "5.0.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
